# zcode-hub 环境变量样例 —— 复制为 .env 后按需修改；.env 永不入库

# ── 服务 ──
ZCODE_PORT=3000
ZCODE_HOST=0.0.0.0
ZCODE_DATA_DIR=data

# ── 鉴权 ──
# 后台管理密码（首次启动写入 meta 表，之后以数据库为准）
ZCODE_ADMIN_KEY=change-me
# 网关 API Key 留空 = 不校验（生产务必设置）
#ZCODE_GATEWAY_KEY=

# ── 公网访问（Cloudflare 隧道）──
# 1 = 网关启动即开一条临时隧道（start-public.bat 用的就是它）；随机域名，关停即失效。
# 后台「设置 → 公网访问」开过一次也会写库，之后同样自动开。
#ZCODE_TUNNEL=1
# cloudflared 不在 PATH 时指定可执行文件路径
#ZCODE_CLOUDFLARED=C:\Program Files (x86)\cloudflared\cloudflared.exe

# ── 上游（一般无需改动）──
# ZAI_UPSTREAM_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
# ZAI_FALLBACK_URL=https://api.z.ai/api/anthropic/v1/messages
# BIGMODEL_UPSTREAM_URL=https://open.bigmodel.cn/api/anthropic/v1/messages
# UPSTREAM_USER_AGENT=ZCode/3.0.1

# ── 验证码求解（Node 子进程）──
ZCODE_NODE_PATH=node
# ZCODE_CAPTCHA_RETRIES=4
# ZCODE_CAPTCHA_TIMEOUT=40
# CAPTCHA_CACHE_TTL=45000

# ── 额度监控 ──
# ZCODE_QUOTA_REFRESH_INTERVAL=60
# ZCODE_COOLING_SECONDS=300

# ── 账号并发 ──
# 单账号并发上限（0 = 不限）；默认 1：上游对「账号 × 模型」并发硬限很低，
# 超了回 429 code 3009，一账号一路最稳。运行时可在后台设置改，以库为准
# ZCODE_ACCOUNT_CONCURRENCY=1
# 所有账号都在飞时排队等空位（秒）：任一槽释放立刻放行，等满才回 503；
# 0 = 不排队（满即 503）。排队人数上限默认 16，超过直接 503 防止无限堆叠
# ZCODE_QUEUE_WAIT_MAX=120
# ZCODE_QUEUE_MAX_WAITERS=16
# 模型并发（3009）时的短等重试：整轮都只是 3009 就等 WAIT 秒再来，最多 ROUNDS 轮
# （上游租约实测 ~2 秒释放；合计 3 秒内能接上的请求就不会变成 503）
# ZCODE_MODEL_BUSY_WAIT=1.0
# ZCODE_MODEL_BUSY_ROUNDS=3

# ── 套餐自动领取轮 ──
# 周期对全部 JWT 账号轮一遍激活上报+查询+领取（0 = 关闭）；运行时可在后台设置改，以库为准
# ZCODE_CLAIM_ROUND_INTERVAL=3600

# ── 秘钥类（不落盘、不入日志）──
# ZSW_PASSWORD=            # .zsb 导出口令（与 zcode-switch 脚本兼容）
# ZCODE_BUNDLE_PASSWORD=   # 备选口令变量
# ZCODE_MASTER_SECRET=     # M1：凭证落库加密主秘钥

# messages 通道请求形态：cli（默认，ZCode CLI 形态，实测可用；不需要无痕验证码）
#                          desktop（旧仿真形态，3.16.x 起 messages 恒 405/3012）
#ZCODE_MESSAGES_STYLE=cli
